<div class="block-improvedmentees">
  <h5 class="mb-2">{{#str}} selectmentee, block_improvedmentees {{/str}}</h5>

  <div class="list-group">
    {{#showall}}
    <a href="{{url}}"
       class="list-group-item list-group-item-action {{#isSelected}}active{{/isSelected}}"
       {{#isSelected}}aria-current="true"{{/isSelected}}>
      {{#str}} showall, block_improvedmentees {{/str}}
    </a>
    {{/showall}}

    {{#mentees}}
      <div class="list-group-item p-0 border-0">
        <a href="{{url}}"
           class="list-group-item list-group-item-action {{#isSelected}}active{{/isSelected}}"
           {{#isSelected}}aria-current="true"{{/isSelected}}>
          <strong>{{fullname}}</strong> <span class="text-body-secondary">[{{username}}]</span>
        </a>

        {{#isSelected}}
          {{#hascourses}}
            <div class="list-group ms-2 mt-0">
              {{#courses}}
                <a href="{{url}}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center bg-secondary">
                  <strong>{{fullname}}</strong>
                  {{#gradepercentage}}
                    <span class="badge bg-primary rounded-pill text-white">
                      {{gradepercentage}}%
                    </span>
                  {{/gradepercentage}}
                  {{^gradepercentage}}
                    <span class="badge bg-secondary rounded-pill">
                      {{#str}} nograde, block_improvedmentees {{/str}}
                    </span>
                  {{/gradepercentage}}
                </a>

                
                {{#hasmissingassignments}}
                    <div class="list-group-item ms-2 mt-1">Missing Assignments <span>{{#missingassignmentcount}}</div>
                    <div class="list-group ms-4 mt-1">
                      {{#missingassignments}}
                        <a href="{{url}}" class="list-group-item list-group-item-action">
                          {{name}}
                        </a>
                      {{/missingassignments}}
                    </div>
                  {{/hasmissingassignments}}
                  {{^hasmissingassignments}}
                    <div class="list-group-item ms-2 mt-1">
                      {{#str}} nomissingassignments, block_improvedmentees {{/str}}
                    </div>
                  {{/hasmissingassignments}}

              {{/courses}}
            </div>
          {{/hascourses}}
          {{^hascourses}}
            <div class="small text-muted ms-3 mt-1">
              {{#str}} nocourses, block_improvedmentees {{/str}}
            </div>
          {{/hascourses}}
        {{/isSelected}}
      </div>
    {{/mentees}}
  </div>
</div>
